{{!< default}}

{{#author}}
<section class="archive-header container author-header">
    {{#if profile_image}}
        <img class="author-header-img" src="{{img_url profile_image size="s"}}" alt="{{name}}">
    {{/if}}
    <div>
        <p class="archive-kicker mono"><span class="accent">$</span> finger {{slug}}</p>
        <h1 class="archive-title">{{name}}</h1>
        {{#if bio}}
            <p class="archive-desc">{{bio}}</p>
        {{/if}}
        <p class="archive-count mono">
            {{plural ../pagination.total empty="no posts" singular="% post" plural="% posts"}}
            {{#if location}}<span aria-hidden="true"> · </span>{{location}}{{/if}}
        </p>
        {{> author-social}}
    </div>
</section>
{{/author}}

<section class="container feed-section">
    <div class="post-feed">
        {{#foreach posts}}
            {{> post-card}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>
